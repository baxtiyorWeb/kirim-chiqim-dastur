# Kirim-Chiqim (Moliya) Backend Environment Configuration
# Copy this file to .env on the server and customize values

# Server Port
PORT=8080

# Environment: 'development' or 'production'
APP_ENV=development

# Database Connection URL (PostgreSQL / Neon PostgreSQL)
# Example Local: postgres://postgres:password@localhost:5432/moliya_db?sslmode=disable
# Example Neon: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_sah4xU5bWrAD@ep-hidden-dew-b4zv77wq-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Authentication Secret Key (Generate a random 32+ character string in production)
JWT_SECRET=replace-with-a-secure-random-jwt-secret-in-production

# Allowed CORS Origins (comma separated, or * for all)
CORS_ORIGINS=*
